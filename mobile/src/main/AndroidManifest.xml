<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.camera.any" />

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Sound for videos; recording works without it (silent) if denied. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Camera and microphone keep working for the watch with the phone locked (silent mode). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Lets the app bring the camera to the foreground when the watch asks, like iPhone Camera Remote. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:name=".OrbityApp"
        android:icon="@android:drawable/ic_menu_camera"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".CameraActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Invisible: shows for a split second so Android lets the camera service start. -->
        <activity
            android:name=".LaunchActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:turnScreenOn="true" />

        <service
            android:name=".CameraService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

        <service
            android:name=".PhoneListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" />
                <data android:host="*" />
                <data android:pathPrefix="/orbity/start" />
                <data android:pathPrefix="/orbity/crash" />
                <data android:pathPrefix="/orbity/log" />
            </intent-filter>
        </service>
    </application>
</manifest>
